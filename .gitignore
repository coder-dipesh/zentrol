# Django
*.log
*.pot
*.pyc
__pycache__/
db.sqlite3
# Django user uploads only (repo-root MEDIA_ROOT). Do not use plain ``media/`` —
# it ignores ``static/media/`` and breaks ``collectstatic`` / WhiteNoise manifest.
/media/

# Environment — never commit real secrets
.env
.env.*
!.env.example
.venv
venv/
env/

# IDE — keep shared workspace settings; ignore local overrides
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node/Webpack
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
.coverage
htmlcov/

# Static files (generated)
staticfiles/

# Misc archives / large artifacts (keep tracked docs undamaged)
static/media.zip
# Duplicate illustration tree (unused by templates; canonical paths are media/images/*.svg)
static/media/images/zentrol_static/
